{
  "name": "pleyn",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An opinionated hypermedia stack: Bun, Hono, hono/html, htmx, Drizzle, PostgreSQL.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etorhub/pleyn.git"
  },
  "workspaces": [
    "packages/*",
    "templates/app",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "typecheck": "bun run --filter '*' typecheck",
    "leaks": "bun run scripts/no-leaks.ts",
    "check": "bun run typecheck && bun run leaks && bun test packages",
    "docs:dev": "bun run --filter @pleyn/docs dev",
    "docs:build": "bun run --filter @pleyn/docs build",
    "docs:sync": "bun run --filter @pleyn/docs sync",
    "docs:check": "bun run --filter @pleyn/docs check"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
