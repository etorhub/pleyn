# Copy to .env. `bun create pleyn` writes one for you, with a real SECRET_KEY.

# What the browser tab says.
APP_NAME=__PROJECT_NAME__

DATABASE_URL=postgresql://pleyn:pleyn@127.0.0.1:5432/pleyn

# At least 32 characters. Signs session cookies and derives CSRF tokens.
# Generate one: openssl rand -base64 32
SECRET_KEY=

PORT=3000
ENVIRONMENT=local

# Where the application is reachable. The Origin of a mutation is checked
# against this.
PUBLIC_BASE_URL=http://localhost:3000

# true in production, behind HTTPS. The application refuses to start in
# production with this false.
COOKIE_SECURE=false

# How long a session lasts.
SESSION_DAYS=14

# Where the server thinks it is, and what language dates are shown in. Two
# different decisions, so two settings.
TZ=UTC
LOCALE=en-GB
